# Local, per-machine Claude Code settings - never shared
.claude/settings.local.json

# Instance facts (principal, conversation language) - never shared
/CLAUDE.local.md

# Projects are repositories of their own, the forge's own project
# among them (POS.1980); the engine tracks none of them, only the
# README of the directory (projects/*, never projects/, so that the
# re-include works)
projects/*
!projects/README.md

# Windows noise
Thumbs.db
desktop.ini

# Office lock files (open documents)
~$*

# tmp/ is the engine's working folder, in git with its own .gitignore
# and README; its contents are ignored there (CLAUDE.md, Repository
# layout)

# Principal's local launcher - never shared
/start-claude.ps1

# Python byte-code caches (scripts/docs_map.py is imported by the docs scripts)
__pycache__/

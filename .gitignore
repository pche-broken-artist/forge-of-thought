# Local, per-machine Claude Code settings - never shared
.claude/settings.local.json

# Instance facts (principal, conversation language) and the git
# identities - never shared
/CLAUDE.local.md
/identities.local.md

# Projects are repositories of their own; the engine tracks only its
# own project. projects/* (never projects/) so the re-include works.
projects/*
!projects/forge

# Windows noise
Thumbs.db
desktop.ini

# Office lock files (open documents)
~$*

# Principal's private scratch at the engine root - never shared
/tmp/

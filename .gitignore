# Local, per-machine Claude Code settings - never shared
.claude/settings.local.json

# Instance facts (principal, conversation language) - never shared
/CLAUDE.local.md

# Projects are repositories of their own, the forge's own project
# among them (POS.1980); the engine tracks none of them, only the
# README of the directory (projects/*, never projects/, so that the
# re-include works)
projects/*
!projects/README.md

# Operating-system noise (selected from gitignore.io: macos, linux,
# windows; https://www.toptal.com/developers/gitignore)
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.apdisk
*.icloud
# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Office lock files (open documents)
~$*

# tmp/ is the engine's working folder, in git with its own .gitignore
# and README; its contents are ignored there (CLAUDE.md, Repository
# layout)

# Principal's local launcher - never shared
/start-claude.ps1

# Python (selected from gitignore.io: python) - scripts/ and tests/;
# scripts/docs_map.py is imported by the docs scripts
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

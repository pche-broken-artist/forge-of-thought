# .gitattributes of a project (templates/gitattributes; POS.1690,
# SOL.0730 of the forge solution design): the ways of merging by
# path. Normalise line endings so files do not fight between machines.
* text=auto
# Way 2, derived: made only on main, taken as ours at a merge and
# made again; the three root files anchored with the slash, since a
# bare name matches at every depth and, with core.ignorecase, in
# every case (recipes/readme.md among them)
renders/** merge=ours
/README.md merge=ours
/RELEASE-NOTES.md merge=ours
/CONTRIBUTING.md merge=ours
docs/** merge=ours
published/*.md merge=ours
# The published files: binary, never merged
published/*.pptx binary
published/*.docx binary
